# ============================================================
# Genshin Mod Manager
# Windows + Linux + Modular Update Agent
# ============================================================


# ------------------------------------------------------------
# Python bytecode / caches
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

*.egg-info/
.eggs/
pip-wheel-metadata/


# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------

.venv/
.venv-*/
venv/
env/
ENV/

.venv-windows/
.venv-linux/


# ------------------------------------------------------------
# Local environment / secrets / certificates
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.p12
*.crt
*.cer


# ------------------------------------------------------------
# Python / PyInstaller build output
# ------------------------------------------------------------

/build/
/dist/
/release/
/AppDir/

# Small-component update feed generated by
# scripts/build_component_feed.py
/component-feed/

# Local helper/build tools
/.build-tools/
appimagetool-*.AppImage

# Built Linux packages
*.AppImage
*.AppImage.sha256

# Build checksums / generated installers
*.exe.sha256


# ------------------------------------------------------------
# Windows installer temporary files
# ------------------------------------------------------------

# Downloaded CPython redistributable used during the installer build.
# The installer is fetched and validated by build_windows_installer.ps1.
/packaging/windows/redist/

# Inno Setup local compiler output/debug files if created beside source
*.iss.tmp
*.iss.bak


# ------------------------------------------------------------
# Linux packaging temporary files
# ------------------------------------------------------------

*.deb
*.rpm
*.pkg.tar.*

# Temporary AppImage mount directories
/squashfs-root/


# ------------------------------------------------------------
# GMM runtime/cache/log files
# ------------------------------------------------------------

/Cache/
/cache/
/logs/
/Logs/

*.log

# Old/internal updater runtime files
update.log
update-helper.py
update-helper.json
update-helper.ps1

.installed
.failed

*.update
*.old


# ------------------------------------------------------------
# Modular Update Agent runtime state
# ------------------------------------------------------------

# These normally live in AppData/XDG folders, but ignore them if a
# development run creates them inside the repository.
update-agent.json
update-agent-command.json
update-agent.lock
update-agent.log

component-state.json

windows-update-handoff.ready
windows-update-handoff.log
windows-installer-update.log

handoff.failed
update.failed
check.failed

*.ready
*.part
*.partial

# Development/runtime component stores if accidentally created in root
/Components/
/components/


# ------------------------------------------------------------
# Local user settings / generated state
# ------------------------------------------------------------

config.json
settings.json
profiles.local.json

# Local databases / caches
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3
*.sqlite3-journal


# ------------------------------------------------------------
# Temporary / backup files
# ------------------------------------------------------------

*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

*.swp
*.swo
*~
~$*


# ------------------------------------------------------------
# Local archives / test packages
# ------------------------------------------------------------

*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ZIP files are normally local build/test packages.
# Remove this rule only if a ZIP intentionally belongs in the repository.
*.zip


