/* ============================================================
   XXMI MOD MANAGER
   Library UI
   ============================================================ */


/* ============================================================
   GLOBAL
   ============================================================ */

QWidget {
    color: #e7e9ef;
    background-color: transparent;
}


/* ============================================================
   LIBRARY HEADER
   ============================================================ */

QFrame#libraryHeader {
    background-color: transparent;
    border: none;
}

QLabel#pageTitle {
    color: #ffffff;
    font-size: 30px;
    font-weight: 800;
}

QLabel#pageDescription {
    color: #8f96a3;
    font-size: 13px;
}


/* ============================================================
   STAT CARDS
   ============================================================ */

QFrame[statCard="true"] {
    background-color: #1c2028;
    border: 1px solid #2b313c;
    border-radius: 14px;
}

QFrame[statCard="true"]:hover {
    background-color: #20252e;
    border-color: #363d49;
}

QFrame#totalStatCard {
    border-left: 3px solid #8067ff;
}

QFrame#activeStatCard {
    border-left: 3px solid #35c47c;
}

QFrame#conflictStatCard {
    border-left: 3px solid #e7a93d;
}

QFrame#characterStatCard {
    border-left: 3px solid #5ba7ff;
}

QLabel#statTitle {
    color: #a6adba;
    font-size: 11px;
    font-weight: 700;
}

QLabel#statValue {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
}

QLabel#statSubtitle {
    color: #707886;
    font-size: 11px;
}


/* ============================================================
   MAIN CARDS
   ============================================================ */

QFrame#filterCard,
QFrame#listPanel,
QFrame#detailsPanel {
    background-color: #1b1f27;
    border: 1px solid #2b313b;
    border-radius: 14px;
}


/* ============================================================
   FILTER
   ============================================================ */

QLabel#fieldCaption,
QLabel#sectionLabel {
    color: #aeb4c0;
    font-size: 11px;
    font-weight: 700;
}

QLabel#libraryPath {
    color: #d5d9e1;

    background-color: #14171d;

    border: 1px solid #2b3039;
    border-radius: 8px;

    padding: 8px 11px;
}

QLabel#locationBadge {
    color: #c9bdff;

    background-color: #30275b;

    border: 1px solid #50428b;
    border-radius: 11px;

    padding: 5px 11px;

    font-weight: 700;
}


/* ============================================================
   SEARCH / COMBOBOX
   ============================================================ */

QLineEdit#searchInput,
QComboBox#filterCombo {
    min-height: 38px;

    background-color: #14171d;

    color: #eef0f5;

    border: 1px solid #303642;
    border-radius: 9px;

    padding-left: 11px;
    padding-right: 11px;

    selection-background-color: #7157e8;
    selection-color: #ffffff;
}

QLineEdit#searchInput:hover,
QComboBox#filterCombo:hover {
    border-color: #414956;
}

QLineEdit#searchInput:focus,
QComboBox#filterCombo:focus {
    border: 1px solid #8067ff;
}

QLineEdit#searchInput:disabled,
QComboBox#filterCombo:disabled {
    color: #646b77;

    background-color: #191c22;

    border-color: #292e36;
}

QComboBox#filterCombo::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #20242c;

    color: #eef0f4;

    border: 1px solid #383f4b;
    border-radius: 7px;

    selection-background-color: #5745ad;
    selection-color: #ffffff;

    outline: none;

    padding: 4px;
}


/* ============================================================
   SELECTION TOOLBAR
   ============================================================ */

QFrame#selectionToolbar {
    background-color: #20242c;

    border: none;

    border-bottom: 1px solid #2d323c;

    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}


/* ============================================================
   MOD TABLE
   ============================================================ */

QTableWidget#modTable {
    background-color: #181c22;

    alternate-background-color: #1b2027;

    color: #e5e7ec;

    border: none;

    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;

    outline: none;

    gridline-color: transparent;

    selection-background-color: #493b8e;
    selection-color: #ffffff;
}

QTableWidget#modTable::item {
    padding: 9px 10px;

    border: none;
    border-bottom: 1px solid #272d35;
}

QTableWidget#modTable::item:hover {
    background-color: #242a33;
}

QTableWidget#modTable::item:selected {
    background-color: #493b8e;

    color: #ffffff;

    border-bottom-color: #5d4aad;
}


/* ============================================================
   TABLE HEADER
   ============================================================ */

QHeaderView {
    background-color: #20252d;
}

QHeaderView::section {
    background-color: #222730;

    color: #aeb5c1;

    border: none;
    border-bottom: 1px solid #343b46;
    border-right: 1px solid #2b3139;

    padding: 10px 9px;

    font-size: 11px;
    font-weight: 800;
}

QHeaderView::section:hover {
    background-color: #292f39;

    color: #ffffff;
}


/* ============================================================
   MOD NAME CELL
   ============================================================ */

QWidget#modNameContainer {
    background-color: transparent;

    border: none;
}

QLabel#modNameLabel {
    color: #f2f3f7;

    background-color: transparent;

    border: none;

    font-weight: 600;
}


/* ============================================================
   INFO BUTTON IN MOD TABLE
   ============================================================ */

QToolButton#modInfoButton {
    background-color: #292f39;

    color: #cdd2dc;

    border: 1px solid #3d4551;
    border-radius: 12px;

    font-weight: 800;
    font-size: 13px;
}

QToolButton#modInfoButton:hover {
    background-color: #7157e8;

    color: #ffffff;

    border-color: #8a73ff;
}

QToolButton#modInfoButton:pressed {
    background-color: #6047d0;
}


/* ============================================================
   DETAILS SCROLL AREA
   ============================================================ */

QScrollArea#detailsScroll {
    background-color: transparent;

    border: none;
}

QScrollArea#detailsScroll > QWidget {
    background-color: transparent;
}

QScrollArea#detailsScroll > QWidget > QWidget {
    background-color: transparent;
}


/* ============================================================
   DETAILS PANEL
   ============================================================ */

QFrame#detailsPanel {
    background-color: #1b1f27;

    border: 1px solid #2c323d;
    border-radius: 14px;
}

QLabel#detailEyebrow {
    color: #8d79ff;

    font-size: 10px;
    font-weight: 900;
}

QLabel#detailTitle {
    color: #ffffff;

    font-size: 22px;
    font-weight: 800;
}

QLabel#detailSubtitle {
    color: #858d9b;

    font-size: 12px;
}

QLabel#detailStatusBadge {
    min-height: 20px;

    font-size: 11px;

    padding-left: 10px;
    padding-right: 10px;
}


/* ============================================================
   DETAILS DIVIDER
   ============================================================ */

QFrame#detailDivider {
    color: #303640;

    background-color: #303640;

    border: none;

    min-height: 1px;
    max-height: 1px;
}


/* ============================================================
   DETAIL SECTIONS
   ============================================================ */

QLabel#detailSectionTitle {
    color: #f7f8fa;

    font-size: 13px;
    font-weight: 800;

    padding-top: 2px;
}

QLabel#detailCaption {
    color: #77808e;

    font-size: 11px;
    font-weight: 700;
}

QLabel#detailValue {
    color: #dfe2e8;

    font-size: 12px;
}


/* ============================================================
   LIBRARY PREVIEW GALLERY
   ============================================================ */

QFrame#libraryPreviewGallery {
    background-color: #11151b;

    border: 1px solid #303743;
    border-radius: 12px;
}

QFrame#libraryPreviewGallery:hover {
    border-color: #3d4654;
}


/* ------------------------------------------------------------
   Preview labels
   ------------------------------------------------------------ */

QFrame#libraryPreviewGallery QLabel {
    color: #929aa8;

    background-color: transparent;

    border: none;
}


/* ------------------------------------------------------------
   Main Preview
   ------------------------------------------------------------ */

QFrame#libraryPreviewGallery QStackedWidget {
    background-color: #0f1217;

    border: none;
    border-radius: 10px;
}


/* ------------------------------------------------------------
   Gallery Navigation
   ------------------------------------------------------------ */

QFrame#libraryPreviewGallery QPushButton {
    min-width: 34px;
    max-width: 42px;

    min-height: 32px;
    max-height: 32px;

    padding: 0px;

    color: #ded9ff;

    background-color: #29243f;

    border: 1px solid #453d68;
    border-radius: 8px;

    font-size: 18px;
    font-weight: 800;
}

QFrame#libraryPreviewGallery QPushButton:hover {
    color: #ffffff;

    background-color: #6550cf;

    border-color: #8067ff;
}

QFrame#libraryPreviewGallery QPushButton:pressed {
    background-color: #5540bc;
}

QFrame#libraryPreviewGallery QPushButton:disabled {
    color: #505662;

    background-color: #1b1e24;

    border-color: #292e36;
}


/* ============================================================
   GENERAL BUTTON BASE
   ============================================================ */

QPushButton,
QToolButton#importButton {
    min-height: 36px;

    padding-left: 14px;
    padding-right: 14px;

    border-radius: 8px;

    font-weight: 700;
}


/* ============================================================
   SECONDARY BUTTONS
   ============================================================ */

QPushButton#refreshButton,
QPushButton#secondaryButton,
QPushButton#secondaryActionButton {
    background-color: #272c35;

    color: #e0e3e9;

    border: 1px solid #3a414d;
}

QPushButton#refreshButton:hover,
QPushButton#secondaryButton:hover,
QPushButton#secondaryActionButton:hover {
    background-color: #323944;

    color: #ffffff;

    border-color: #4d5664;
}

QPushButton#refreshButton:pressed,
QPushButton#secondaryButton:pressed,
QPushButton#secondaryActionButton:pressed {
    background-color: #242a32;
}


/* ============================================================
   PRIMARY ACTION
   ============================================================ */

QToolButton#importButton,
QPushButton#primaryActionButton {
    background-color: #7157e8;

    color: #ffffff;

    border: 1px solid #846cff;
}

QToolButton#importButton:hover,
QPushButton#primaryActionButton:hover {
    background-color: #8067ff;

    border-color: #9b8aff;
}

QToolButton#importButton:pressed,
QPushButton#primaryActionButton:pressed {
    background-color: #6047d0;
}


/* ============================================================
   WARNING ACTION
   ============================================================ */

QPushButton#warningActionButton {
    background-color: #453314;

    color: #ffd485;

    border: 1px solid #70531f;
}

QPushButton#warningActionButton:hover {
    background-color: #594219;

    color: #ffe2ad;

    border-color: #8b6727;
}

QPushButton#warningActionButton:pressed {
    background-color: #3b2c11;
}


/* ============================================================
   BULK ENABLE
   ============================================================ */

QPushButton#bulkEnableButton {
    background-color: #163827;

    color: #71e2a7;

    border: 1px solid #285b40;
}

QPushButton#bulkEnableButton:hover {
    background-color: #1e4b34;

    color: #8cebb8;

    border-color: #347653;
}

QPushButton#bulkEnableButton:pressed {
    background-color: #143021;
}


/* ============================================================
   BULK DISABLE
   ============================================================ */

QPushButton#bulkDisableButton {
    background-color: #403214;

    color: #f6cb6f;

    border: 1px solid #655020;
}

QPushButton#bulkDisableButton:hover {
    background-color: #56441a;

    color: #ffdb89;

    border-color: #826728;
}

QPushButton#bulkDisableButton:pressed {
    background-color: #35290f;
}


/* ============================================================
   BULK ADOPT
   ============================================================ */

QPushButton#bulkAdoptButton {
    background-color: #30265a;

    color: #c8baff;

    border: 1px solid #50418b;
}

QPushButton#bulkAdoptButton:hover {
    background-color: #423476;

    color: #ded7ff;

    border-color: #6858aa;
}

QPushButton#bulkAdoptButton:pressed {
    background-color: #29204d;
}


/* ============================================================
   DANGER
   ============================================================ */

QPushButton#dangerButton {
    background-color: #472027;

    color: #ff9ca7;

    border: 1px solid #71313b;
}

QPushButton#dangerButton:hover {
    background-color: #5b2932;

    color: #ffb4bd;

    border-color: #93404d;
}

QPushButton#dangerButton:pressed {
    background-color: #39191f;
}


/* ============================================================
   DISABLED BUTTONS
   ============================================================ */

QPushButton:disabled,
QToolButton:disabled {
    background-color: #23272e;

    color: #5d6470;

    border-color: #303640;
}


/* ============================================================
   PROGRESS
   ============================================================ */

QProgressBar {
    min-height: 22px;

    background-color: #171a20;

    color: #e5e7eb;

    border: 1px solid #303641;
    border-radius: 7px;

    text-align: center;

    font-size: 11px;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #7157e8;

    border-radius: 6px;
}


/* ============================================================
   STATUS
   ============================================================ */

QLabel#libraryStatus {
    color: #858d9b;

    font-size: 12px;
}


/* ============================================================
   SPLITTER
   ============================================================ */

QSplitter#librarySplitter::handle {
    background-color: transparent;

    width: 12px;
}

QSplitter#librarySplitter::handle:hover {
    background-color: #292e37;

    border-radius: 4px;
}


/* ============================================================
   SCROLLBARS
   ============================================================ */

QScrollBar:vertical {
    background-color: #15181e;

    width: 10px;

    margin: 0px;

    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3a404b;

    min-height: 30px;

    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555e6c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;

    background-color: transparent;

    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}


/* ------------------------------------------------------------
   Horizontal scrollbar
   ------------------------------------------------------------ */

QScrollBar:horizontal {
    background-color: #15181e;

    height: 10px;

    margin: 0px;

    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3a404b;

    min-width: 30px;

    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555e6c;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;

    background-color: transparent;

    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background-color: #15181e;
}


/* ============================================================
   TOOLTIPS
   ============================================================ */

QToolTip {
    color: #f3f4f6;

    background-color: #252a33;

    border: 1px solid #454d59;
    border-radius: 6px;

    padding: 6px;
}
/* ============================================================
   LIBRARY VIEW SWITCHER
   ============================================================ */

QFrame#libraryViewToolbar {
    background-color: #1b1f27;

    border: 1px solid #2b313b;
    border-radius: 10px;
}

QPushButton#libraryViewButton {
    min-height: 32px;

    padding-left: 14px;
    padding-right: 14px;

    background-color: transparent;

    color: #8e96a4;

    border: 1px solid transparent;
    border-radius: 7px;

    font-weight: 700;
}

QPushButton#libraryViewButton:hover {
    background-color: #272d36;

    color: #ffffff;
}

QPushButton#libraryViewButton:checked {
    background-color: #342a60;

    color: #ffffff;

    border-color: #6753c7;
}


/* ============================================================
   GALLERY
   ============================================================ */

QWidget#libraryGallery {
    background-color: transparent;
}

QScrollArea#libraryGalleryScroll {
    background-color: transparent;
    border: none;
}

QWidget#libraryGalleryContent {
    background-color: transparent;
}


/* ============================================================
   MOD CARD
   ============================================================ */

QFrame#libraryModCard {
    background-color: #1b1f27;

    border: 1px solid #2d3440;
    border-radius: 12px;
}

QFrame#libraryModCard:hover {
    background-color: #20252e;

    border-color: #55479a;
}

QFrame#libraryModCard[modState="enabled"] {
    border-color: #2e7350;
}

QFrame#libraryModCard[modState="conflict"] {
    border-color: #936720;
}

QFrame#libraryModCard[modState="broken"] {
    border-color: #87404c;
}


/* ============================================================
   PREVIEW
   ============================================================ */

QFrame#libraryCardPreview {
    background-color: #0e1116;

    border: 1px solid #292f39;
    border-radius: 9px;
}

QFrame#libraryCardPreview QStackedWidget {
    background-color: #0e1116;

    border: none;
    border-radius: 8px;
}

QLabel#libraryCardPreviewEmpty {
    background-color: #0e1116;

    color: #68717f;

    font-size: 12px;
}

QLabel#libraryCardPreviewLocal {
    background-color: #0e1116;

    border: none;
}


/* ============================================================
   CARD TEXT
   ============================================================ */

QLabel#libraryCardTitle {
    color: #ffffff;

    font-size: 15px;
    font-weight: 800;
}

QLabel#libraryCardMeta {
    color: #8d95a3;

    font-size: 11px;
}

QLabel#libraryCardState {
    color: #a998ff;

    font-size: 11px;
    font-weight: 700;
}


/* ============================================================
   CARD ACTION
   ============================================================ */

QPushButton#libraryCardAction {
    min-height: 38px;

    padding-left: 13px;
    padding-right: 13px;

    background-color: #30275b;

    color: #ddd6ff;

    border: 1px solid #51428f;
    border-radius: 8px;

    font-weight: 800;
}

QPushButton#libraryCardAction:hover {
    background-color: #7157e8;

    color: #ffffff;

    border-color: #8c77ff;
}

QPushButton#libraryCardAction:pressed {
    background-color: #5c45ca;
}

QPushButton#libraryCardAction:disabled {
    background-color: #22262d;

    color: #5f6672;

    border-color: #303640;
}

/* ============================================================
   CONFLICTS
   ============================================================ */

QLabel#conflictCount {
    color: #ffc76d;

    font-size: 17px;
    font-weight: 800;
}

QLabel#conflictsEmpty {
    color: #747d8b;

    font-size: 14px;
}


/* ============================================================
   CONFLICT CARD
   ============================================================ */

QFrame#conflictCard {
    background-color: #1b1f27;

    border: 1px solid #49391e;
    border-left: 3px solid #d89b38;
    border-radius: 11px;
}

QFrame#conflictCard:hover {
    background-color: #20252d;

    border-color: #725625;
    border-left-color: #f0b34d;
}

QFrame#conflictCard[conflictKind="library"] {
    border-left-color: #efb24e;
}

QFrame#conflictCard[conflictKind="unmanaged_active"] {
    border-left-color: #e47e55;
}

QFrame#conflictCard[conflictKind="invalid_marker"] {
    border-left-color: #e85d6a;
}

QFrame#conflictCard[conflictKind="orphaned_managed"] {
    border-left-color: #a77bea;
}

QLabel#conflictTitle {
    color: #f5f6f8;

    font-size: 15px;
    font-weight: 800;
}

QLabel#conflictType {
    color: #ffc76d;

    background-color: #3b2d15;

    border: 1px solid #665026;
    border-radius: 8px;

    padding: 4px 8px;

    font-size: 10px;
    font-weight: 800;
}

QLabel#conflictMessage {
    color: #b0b6c1;

    font-size: 12px;
}

QLabel#conflictPath {
    color: #747e8c;

    background-color: #13171c;

    border: 1px solid #2c323a;
    border-radius: 7px;

    padding: 7px 9px;

    font-family: monospace;
    font-size: 11px;
}
/* ============================================================
   CONFLICT HASH / DUPLICATE
   ============================================================ */

QLabel#conflictHashStatus {
    color: #c0c6d1;
    font-size: 12px;
    font-weight: 600;
    padding-top: 5px;
}

QLabel#conflictHash {
    color: #8993a3;
    background-color: #12161c;

    border: 1px solid #2b323d;
    border-radius: 6px;

    padding: 6px 8px;

    font-family: monospace;
    font-size: 11px;
}

QLabel#conflictDuplicate {
    color: #6fd69a;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#dangerButton {
    background-color: #4a2027;
    color: #ffbec5;

    border: 1px solid #75343e;
    border-radius: 7px;

    padding: 7px 12px;
}

QPushButton#dangerButton:hover {
    background-color: #612832;
    border-color: #9a4653;
}

/* GMM UI OVERHAUL V1 */

/* ============================================================
   LIBRARY PAGE / WORKSPACE
   ============================================================ */

QWidget#libraryPage {
    background-color: #101319;
    color: #e7e9ef;
}

QFrame#libraryHeader {
    background-color: transparent;
    border: none;
}

QLabel#pageTitle {
    color: #ffffff;
    font-size: 27px;
    font-weight: 800;
}

QLabel#pageDescription {
    color: #89919f;
    font-size: 13px;
}

QFrame[statCard="true"] {
    min-height: 82px;
    background-color: #181c23;
    border: 1px solid #292f39;
    border-radius: 12px;
}

QFrame[statCard="true"]:hover {
    background-color: #1c2129;
    border-color: #363e4a;
}

QLabel#statValue {
    font-size: 24px;
}

QFrame#filterCard {
    background-color: #171b22;
    border: 1px solid #292f39;
    border-radius: 12px;
}

QLabel#libraryPath {
    background-color: #11151a;
    border: 1px solid #292f39;
    border-radius: 8px;
}

QLineEdit#searchInput,
QComboBox#filterCombo {
    background-color: #11151a;
    border-color: #2c333e;
}

QLineEdit#searchInput:focus,
QComboBox#filterCombo:focus {
    border-color: #8067ff;
}

QFrame#libraryWorkspace {
    background-color: #151920;
    border: 1px solid #292f39;
    border-radius: 14px;
}

QFrame#libraryViewToolbar {
    background-color: #181c23;
    border: none;
    border-bottom: 1px solid #292f39;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}

QLabel#libraryViewTitle {
    color: #aeb5c2;
    font-size: 11px;
    font-weight: 800;
}

QFrame#libraryViewModeFrame {
    background-color: #101319;
    border: 1px solid #2a303a;
    border-radius: 9px;
}

QPushButton#libraryViewButton {
    min-height: 31px;
    padding-left: 13px;
    padding-right: 13px;
    background-color: transparent;
    color: #8f98a7;
    border: 1px solid transparent;
    border-radius: 7px;
    font-weight: 700;
}

QPushButton#libraryViewButton:hover {
    background-color: #232932;
    color: #f4f5f7;
}

QPushButton#libraryViewButton:checked {
    background-color: #372c66;
    color: #ffffff;
    border-color: #58499a;
}

QFrame#listPanel {
    background-color: #151920;
    border: none;
    border-right: 1px solid #292f39;
    border-radius: 0px;
}

QFrame#detailsPanel {
    background-color: #161a21;
    border: none;
    border-radius: 0px;
}

QSplitter#librarySplitter {
    background-color: transparent;
    border: none;
}

QSplitter#librarySplitter::handle {
    background-color: #101319;
    width: 8px;
}

QSplitter#librarySplitter::handle:hover {
    background-color: #30275b;
}

QTableWidget#modTable {
    background-color: #14181f;
    alternate-background-color: #171c23;
    border: none;
    border-radius: 0px;
}

QTableWidget#modTable::item {
    min-height: 38px;
    padding: 9px 10px;
    border-bottom: 1px solid #252b34;
}

QHeaderView::section {
    background-color: #1b2028;
    color: #aeb5c2;
    border: none;
    border-bottom: 1px solid #2c333d;
    padding: 9px 10px;
    font-weight: 800;
}

QWidget#libraryGallery {
    background-color: #151920;
}

QScrollArea#libraryGalleryScroll,
QWidget#libraryGalleryContent {
    background-color: #151920;
    border: none;
}

QFrame#libraryModCard {
    background-color: #1a1f27;
    border: 1px solid #2c333e;
    border-radius: 14px;
}

QFrame#libraryModCard:hover {
    background-color: #20262f;
    border-color: #6252ad;
}

QFrame#libraryModCard[modState="enabled"] {
    border-color: #347957;
}

QFrame#libraryModCard[modState="conflict"] {
    border-color: #9b6d24;
}

/* ============================================================
   CONFLICT PAGE - WINDOWS SAFE
   ============================================================ */

QWidget#conflictsPage {
    background-color: #101319;
    color: #e7e9ef;
}

QWidget#conflictsPage QLabel {
    background-color: transparent;
    color: #e7e9ef;
}

QScrollArea#conflictsScroll {
    background-color: #101319;
    border: none;
}

QScrollArea#conflictsScroll > QWidget,
QScrollArea#conflictsScroll > QWidget > QWidget {
    background-color: #101319;
}

QWidget#conflictsContent {
    background-color: #101319;
}

QFrame#conflictCard {
    background-color: #181c23;
    border: 1px solid #49391e;
    border-left: 3px solid #d89b38;
    border-radius: 11px;
}

QFrame#conflictCard:hover {
    background-color: #1e232b;
}

QLabel#conflictTitle {
    color: #f5f6f8;
}

QLabel#conflictMessage {
    color: #b0b6c1;
}

QLabel#conflictPath {
    color: #929baa;
    background-color: #11151a;
    border: 1px solid #2b323b;
}

QLabel#conflictHashStatus {
    color: #c0c6d1;
}

QLabel#conflictHash {
    color: #929baa;
    background-color: #11151a;
}

QLabel#conflictDuplicate {
    color: #6fd69a;
}
/* ============================================================
   LIBRARY LIST / DETAILS V2
   ============================================================ */


/* ------------------------------------------------------------
   Selection toolbar
   ------------------------------------------------------------ */

QFrame#selectionToolbar {
    min-height: 58px;

    background-color: #181d24;

    border: none;
    border-bottom: 1px solid #292f39;

    border-radius: 0px;
}


/* ------------------------------------------------------------
   Modern table
   ------------------------------------------------------------ */

QTableWidget#modTable {
    background-color: #14181f;
    alternate-background-color: #171c23;

    color: #e6e9ef;

    border: none;
    border-radius: 0px;

    outline: none;

    selection-background-color: #292344;
    selection-color: #ffffff;
}

QTableWidget#modTable::item {
    min-height: 40px;

    padding: 6px 10px;

    border: none;
    border-bottom: 1px solid #242a32;
}

QTableWidget#modTable::item:hover {
    background-color: #1e242c;
}

QTableWidget#modTable::item:selected {
    background-color: #292344;

    color: #ffffff;

    border-bottom-color: #3d3560;
}

QHeaderView::section {
    min-height: 34px;

    background-color: #181d24;

    color: #949dab;

    border: none;
    border-bottom: 1px solid #2b323b;

    padding: 7px 10px;

    font-size: 11px;
    font-weight: 800;
}


/* ------------------------------------------------------------
   Mod name
   ------------------------------------------------------------ */

QWidget#modNameContainer {
    background-color: transparent;
}

QLabel#modNameLabel {
    background-color: transparent;

    color: #f1f3f6;

    font-size: 12px;
    font-weight: 650;
}


/* ------------------------------------------------------------
   Status cell
   ------------------------------------------------------------ */

QWidget#modStateContainer {
    background-color: transparent;

    border: none;
}

QLabel#modStateBadge {
    min-height: 23px;

    padding-left: 8px;
    padding-right: 8px;

    background-color: #272d36;

    color: #b8c0cc;

    border: 1px solid #343c47;
    border-radius: 7px;

    font-size: 10px;
    font-weight: 800;
}

QLabel#modStateBadge[modState="enabled"] {
    background-color: #163728;

    color: #74dfa8;

    border-color: #285b41;
}

QLabel#modStateBadge[modState="disabled"] {
    background-color: #252b34;

    color: #aeb7c4;

    border-color: #353d48;
}

QLabel#modStateBadge[modState="conflict"] {
    background-color: #453014;

    color: #ffc76d;

    border-color: #6a4a1d;
}

QLabel#modStateBadge[modState="broken"] {
    background-color: #432128;

    color: #ff939f;

    border-color: #6c323d;
}

QLabel#modStateBadge[modState="not_configured"] {
    background-color: #302640;

    color: #d4b7ff;

    border-color: #50406a;
}


/* ============================================================
   DETAILS V2
   ============================================================ */

QScrollArea#detailsScroll {
    background-color: #12161c;

    border: none;
}

QScrollArea#detailsScroll > QWidget,
QScrollArea#detailsScroll > QWidget > QWidget {
    background-color: #12161c;
}

QFrame#detailsPanel {
    background-color: #12161c;

    border: none;
    border-radius: 0px;
}


/* ------------------------------------------------------------
   Detail cards
   ------------------------------------------------------------ */

QFrame#detailHeaderCard,
QFrame#detailPreviewCard,
QFrame#detailInfoCard,
QFrame#detailActionCard {
    background-color: #191e25;

    border: 1px solid #2b323c;
    border-radius: 11px;
}

QFrame#detailHeaderCard {
    background-color: #1b2028;
}


/* ------------------------------------------------------------
   Detail title
   ------------------------------------------------------------ */

QLabel#detailEyebrow {
    color: #8f7cff;

    font-size: 10px;
    font-weight: 900;
}

QLabel#detailTitle {
    color: #f7f8fa;

    font-size: 19px;
    font-weight: 800;
}

QLabel#detailSubtitle {
    color: #8d96a4;

    font-size: 11px;
}


/* ------------------------------------------------------------
   Detail fields
   ------------------------------------------------------------ */

QFrame#detailField {
    background-color: #14181e;

    border: 1px solid #272e37;
    border-radius: 8px;
}

QFrame#detailField:hover {
    background-color: #171c23;

    border-color: #333b47;
}

QLabel#detailCaption {
    background-color: transparent;

    color: #747e8c;

    font-size: 10px;
    font-weight: 800;
}

QLabel#detailValue {
    background-color: transparent;

    color: #e1e4e9;

    font-size: 11px;
    font-weight: 600;
}


/* ------------------------------------------------------------
   Sections
   ------------------------------------------------------------ */

QLabel#detailSectionTitle {
    color: #dfe3e9;

    font-size: 11px;
    font-weight: 900;

    padding: 0px;
}


/* ------------------------------------------------------------
   Detail actions
   ------------------------------------------------------------ */

QFrame#detailActionCard QPushButton {
    min-height: 34px;

    border-radius: 7px;

    font-size: 11px;
    font-weight: 750;
}
/* ============================================================
   LIBRARY TOP TOOLBAR V2
   ============================================================ */


/* ------------------------------------------------------------
   Compact filter area
   ------------------------------------------------------------ */

QFrame#filterCard {
    background-color: #171b22;

    border: 1px solid #292f39;
    border-radius: 10px;
}

QLabel#fieldCaption {
    color: #7f8997;

    font-size: 10px;
    font-weight: 800;
}

QLabel#libraryPath {
    min-height: 30px;

    padding-left: 10px;
    padding-right: 10px;

    background-color: #11151a;

    color: #adb5c1;

    border: 1px solid #292f39;
    border-radius: 7px;
}

QLabel#locationBadge {
    min-height: 24px;

    padding-left: 9px;
    padding-right: 9px;

    background-color: #182a22;

    color: #70d89e;

    border: 1px solid #29503d;
    border-radius: 7px;

    font-size: 10px;
    font-weight: 800;
}


/* ------------------------------------------------------------
   Search + filters
   ------------------------------------------------------------ */

QLineEdit#searchInput,
QComboBox#filterCombo {
    min-height: 34px;

    background-color: #11151a;

    color: #dde1e7;

    border: 1px solid #2c333e;
    border-radius: 7px;

    padding-left: 10px;
    padding-right: 10px;
}

QLineEdit#searchInput:hover,
QComboBox#filterCombo:hover {
    border-color: #414a58;
}

QLineEdit#searchInput:focus,
QComboBox#filterCombo:focus {
    border-color: #8067ff;
}


/* ------------------------------------------------------------
   View toolbar
   ------------------------------------------------------------ */

QFrame#libraryViewToolbar {
    min-height: 48px;

    background-color: #181c23;

    border: none;
    border-bottom: 1px solid #292f39;

    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}

QLabel#libraryViewTitle {
    color: #e1e4e9;

    font-size: 11px;
    font-weight: 900;
}

QLabel#libraryViewCount {
    padding: 4px 8px;

    background-color: #11151a;

    color: #8f99a8;

    border: 1px solid #2b323c;
    border-radius: 7px;

    font-size: 10px;
    font-weight: 700;
}

QFrame#libraryViewModeFrame {
    background-color: #101319;

    border: 1px solid #2a303a;
    border-radius: 9px;
}

QPushButton#libraryViewButton {
    min-height: 30px;

    padding-left: 11px;
    padding-right: 11px;

    background-color: transparent;

    color: #8f98a7;

    border: 1px solid transparent;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 700;
}

QPushButton#libraryViewButton:hover {
    background-color: #232932;

    color: #f4f5f7;
}

QPushButton#libraryViewButton:checked {
    background-color: #372c66;

    color: #ffffff;

    border-color: #58499a;
}
/* ============================================================
   LIBRARY HEADER V2
   ============================================================ */


/* ------------------------------------------------------------
   Header
   ------------------------------------------------------------ */

QFrame#libraryHeader {
    min-height: 66px;

    background-color: transparent;

    border: none;
}


/* ------------------------------------------------------------
   Title
   ------------------------------------------------------------ */

QFrame#libraryHeader QLabel#pageTitle {
    background-color: transparent;

    color: #f5f6f8;

    font-size: 27px;
    font-weight: 850;
}

QFrame#libraryHeader QLabel#pageDescription {
    background-color: transparent;

    color: #838d9b;

    font-size: 12px;
}


/* ============================================================
   HEADER ACTION GROUP
   ============================================================ */

QFrame#libraryHeaderActions {
    background-color: #15191f;

    border: 1px solid #292f38;
    border-radius: 11px;
}


/* ============================================================
   SCAN
   ============================================================ */

QPushButton#refreshButton {
    min-height: 38px;

    padding-left: 14px;
    padding-right: 14px;

    background-color: #20252d;

    color: #d8dce3;

    border: 1px solid #303742;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 750;
}

QPushButton#refreshButton:hover {
    background-color: #292f39;

    color: #ffffff;

    border-color: #434c59;
}

QPushButton#refreshButton:pressed {
    background-color: #1b2027;

    border-color: #353c46;
}

QPushButton#refreshButton:disabled {
    background-color: #181c22;

    color: #565e69;

    border-color: #252b33;
}


/* ============================================================
   IMPORT
   ============================================================ */

QToolButton#importButton {
    min-height: 38px;

    padding-left: 15px;
    padding-right: 31px;

    background-color: #7157e8;

    color: #ffffff;

    border: 1px solid #846cff;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 800;
}

QToolButton#importButton:hover {
    background-color: #8067ff;

    border-color: #9c8aff;
}

QToolButton#importButton:pressed {
    background-color: #6249d4;
}


/* ------------------------------------------------------------
   Import menu section
   ------------------------------------------------------------ */

QToolButton#importButton::menu-button {
    width: 26px;

    background-color: rgba(0, 0, 0, 28);

    border: none;
    border-left: 1px solid #927eff;

    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QToolButton#importButton::menu-button:hover {
    background-color: rgba(255, 255, 255, 20);
}

QToolButton#importButton::menu-arrow {
    width: 7px;
    height: 7px;
}


/* ------------------------------------------------------------
   Disabled import
   ------------------------------------------------------------ */

QToolButton#importButton:disabled {
    background-color: #262230;

    color: #686173;

    border-color: #342e40;
}

QToolButton#importButton:disabled::menu-button {
    border-left-color: #3a3347;
}


/* ============================================================
   IMPORT MENU
   ============================================================ */

QMenu#libraryImportMenu {
    min-width: 210px;

    padding: 6px;

    background-color: #1a1f26;

    color: #e2e5ea;

    border: 1px solid #333a45;
    border-radius: 9px;
}

QMenu#libraryImportMenu::item {
    min-height: 30px;

    padding: 5px 12px;

    background-color: transparent;

    border-radius: 6px;
}

QMenu#libraryImportMenu::item:selected {
    background-color: #292f3a;

    color: #ffffff;
}


/* ============================================================
   CANCEL IMPORT
   ============================================================ */

QPushButton#libraryCancelImportButton {
    min-height: 38px;

    padding-left: 13px;
    padding-right: 13px;

    background-color: #3c2026;

    color: #ff9da7;

    border: 1px solid #65313a;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 750;
}

QPushButton#libraryCancelImportButton:hover {
    background-color: #512831;

    color: #ffb2ba;

    border-color: #82404b;
}

QPushButton#libraryCancelImportButton:pressed {
    background-color: #341a20;
}

QPushButton#libraryCancelImportButton:disabled {
    background-color: #251a1d;

    color: #685056;

    border-color: #39252a;
}
/* ============================================================
   LIBRARY STATS V2
   ============================================================ */


/* ------------------------------------------------------------
   Base card
   ------------------------------------------------------------ */

QFrame[statCard="true"] {
    min-height: 74px;

    background-color: #181d24;

    border: 1px solid #292f39;
    border-radius: 11px;
}

QFrame[statCard="true"]:hover {
    background-color: #1d222a;

    border-color: #353d48;
}


/* ------------------------------------------------------------
   Total
   ------------------------------------------------------------ */

QFrame#totalStatCard {
    border-left: 3px solid #8067ff;
}


/* ------------------------------------------------------------
   Active
   ------------------------------------------------------------ */

QFrame#activeStatCard {
    border-left: 3px solid #36c982;
}


/* ------------------------------------------------------------
   Character
   ------------------------------------------------------------ */

QFrame#characterStatCard {
    border-left: 3px solid #589cf5;
}


/* ------------------------------------------------------------
   Conflict - normal state
   ------------------------------------------------------------ */

QFrame#conflictStatCard {
    border-left: 3px solid #59616d;
}


/* ------------------------------------------------------------
   Conflict - requires attention
   ------------------------------------------------------------ */

QFrame#conflictStatCard[attention="true"] {
    background-color: #241e14;

    border: 1px solid #5c431f;
    border-left: 3px solid #e8a93c;
}

QFrame#conflictStatCard[attention="true"]:hover {
    background-color: #2b2317;

    border-color: #765526;
    border-left-color: #f0b34a;
}


/* ============================================================
   STAT TEXT
   ============================================================ */

QLabel#statTitle {
    background-color: transparent;

    color: #9ba4b2;

    font-size: 10px;
    font-weight: 800;
}

QLabel#statSubtitle {
    background-color: transparent;

    color: #626c79;

    font-size: 10px;
    font-weight: 600;
}

QLabel#statValue {
    background-color: transparent;

    color: #f2f4f7;

    font-size: 25px;
    font-weight: 850;
}


/* ------------------------------------------------------------
   Conflict value
   ------------------------------------------------------------ */

QLabel#statValue[attention="true"] {
    color: #ffc866;
}
/* ============================================================
   GALLERY CARD ACTIONS V2
   ============================================================ */


/* ------------------------------------------------------------
   Selected card
   ------------------------------------------------------------ */

QFrame#libraryModCard[selected="true"] {
    background-color: #1f1c2b;

    border: 1px solid #8067ff;
}

QFrame#libraryModCard[selected="true"]:hover {
    border-color: #9a87ff;
}


/* ------------------------------------------------------------
   More button
   ------------------------------------------------------------ */

QToolButton#libraryCardMoreButton {
    background-color: transparent;

    color: #8f98a6;

    border: 1px solid transparent;
    border-radius: 7px;

    font-size: 18px;
    font-weight: 800;
}

QToolButton#libraryCardMoreButton:hover {
    background-color: #272d36;

    color: #ffffff;

    border-color: #373f4a;
}

QToolButton#libraryCardMoreButton:pressed {
    background-color: #1d2229;
}


/* ============================================================
   CARD MENU
   ============================================================ */

QMenu#libraryCardMenu {
    min-width: 205px;

    padding: 6px;

    background-color: #191e25;

    color: #e1e5ea;

    border: 1px solid #333a45;
    border-radius: 9px;
}

QMenu#libraryCardMenu::item {
    min-height: 28px;

    padding: 5px 12px;

    background-color: transparent;

    border-radius: 6px;
}

QMenu#libraryCardMenu::item:selected {
    background-color: #2b313c;

    color: #ffffff;
}

QMenu#libraryCardMenu::separator {
    height: 1px;

    margin: 5px 8px;

    background-color: #303741;
}


/* ------------------------------------------------------------
   Card title
   ------------------------------------------------------------ */

QLabel#libraryCardTitle {
    background-color: transparent;

    color: #f2f4f7;

    font-size: 12px;
    font-weight: 800;
}


/* ------------------------------------------------------------
   Status
   ------------------------------------------------------------ */

QLabel#libraryCardState {
    min-height: 22px;

    padding-left: 8px;
    padding-right: 8px;

    background-color: #252b34;

    color: #aeb6c2;

    border: 1px solid #343c47;
    border-radius: 7px;

    font-size: 10px;
    font-weight: 800;
}

QLabel#libraryCardState[modState="enabled"] {
    background-color: #163728;

    color: #74dfa8;

    border-color: #285b41;
}

QLabel#libraryCardState[modState="conflict"] {
    background-color: #453014;

    color: #ffc76d;

    border-color: #6a4a1d;
}

QLabel#libraryCardState[modState="broken"] {
    background-color: #432128;

    color: #ff939f;

    border-color: #6c323d;
}
/* ============================================================
   LIBRARY EMPTY STATES
   ============================================================ */

QFrame#libraryEmptyState {
    background-color: #14181e;

    border: 1px solid #282e37;
    border-radius: 11px;
}


/* Icon */

QLabel#libraryEmptyIcon {
    background-color: transparent;

    color: #7060d9;

    font-size: 38px;
    font-weight: 700;
}


/* Title */

QLabel#libraryEmptyTitle {
    background-color: transparent;

    color: #f1f3f6;

    font-size: 17px;
    font-weight: 850;
}


/* Description */

QLabel#libraryEmptyDescription {
    background-color: transparent;

    color: #7f8997;

    font-size: 11px;
    font-weight: 600;
}


/* Primary */

QPushButton#libraryEmptyPrimaryButton {
    min-height: 36px;

    padding-left: 16px;
    padding-right: 16px;

    background-color: #7157e8;

    color: #ffffff;

    border: 1px solid #846cff;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 800;
}

QPushButton#libraryEmptyPrimaryButton:hover {
    background-color: #8067ff;

    border-color: #9c8aff;
}


/* Secondary */

QPushButton#libraryEmptySecondaryButton {
    min-height: 36px;

    padding-left: 16px;
    padding-right: 16px;

    background-color: #20252d;

    color: #d8dce3;

    border: 1px solid #303742;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 750;
}

QPushButton#libraryEmptySecondaryButton:hover {
    background-color: #292f39;

    color: #ffffff;

    border-color: #434c59;
}

/* ============================================================
   RESPONSIVE POLISH V1
   ============================================================ */

QSplitter#librarySplitter::handle:vertical {
    height: 8px;
    width: auto;
}

QFrame#selectionToolbar[responsiveMode="compact"] {
    min-height: 94px;
}

QWidget#libraryPage[responsiveMode="tight"] QFrame#libraryViewToolbar {
    margin-left: 0px;
    margin-right: 0px;
}


/* ============================================================
   WINDOWS / TRANSLATION BOX SIZING SAFETY V1
   ============================================================ */

QFrame#libraryHeader,
QFrame#filterCard,
QFrame#selectionToolbar,
QFrame#detailHeaderCard,
QFrame#detailPreviewCard,
QFrame#detailInfoCard,
QFrame#detailActionCard,
QFrame#libraryModCard {
    max-height: 16777215px;
}

QLineEdit#searchInput,
QComboBox#filterCombo {
    max-height: 16777215px;
}

QFrame#detailActionCard QPushButton,
QPushButton#libraryCardAction {
    min-width: 0px;
}
