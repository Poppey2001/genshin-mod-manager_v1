{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "@locales/*": ["../app/i18n/locales/*"],
      "@assets/*": ["../assets/*"]
    }
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.svelte"]
}
